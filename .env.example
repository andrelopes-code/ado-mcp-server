# Base da coleção on-prem, ex: https://servidor/colecao
# Prefira https: sobre http o PAT viaja em Basic auth sem TLS (o server avisa no boot).
DEVOPS_URL=
# Projeto padrão (blast radius)
DEVOPS_PROJECT=
# PAT dedicado, escopos mínimos (Work Items RW, Code RW, PR Threads RW), expiração curta
DEVOPS_PAT=
# Versão da REST API (comprovada no on-prem)
API_VERSION=6.0
# read = só leitura (default seguro) | write = habilita mutações
ADO_MODE=read
# Outros projetos alcançáveis pelo parâmetro `project` das tools (vazio = só DEVOPS_PROJECT; * = todos)
ADO_PROJECT_ALLOWLIST=
# Tipos de work item que wit_create pode criar (vazio = todos os do processo)
ADO_WIT_TYPE_ALLOWLIST=
# Area paths onde a escrita de work item é permitida (vazio = todo o projeto)
ADO_WIT_AREA_ALLOWLIST=
# Limite de tamanho de anexo em MB (default 25)
ADO_ATTACH_MAX_MB=25
# Extensões de anexo permitidas (vazio = todas)
ADO_ATTACH_EXT_ALLOWLIST=
# Repos permitidos, separados por vírgula (vazio = todos)
ADO_REPO_ALLOWLIST=
# Branches sob sinalização reforçada
ADO_PROTECTED_BRANCHES=main,master,develop,release/*
# Trilha de auditoria de escritas (relativo = a partir do diretório do server)
ADO_AUDIT_LOG=./ado-mcp-audit.log
# Timeout das chamadas HTTP em ms (default 30000)
ADO_TIMEOUT_MS=30000
